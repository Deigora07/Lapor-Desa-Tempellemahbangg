rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      // Pengguna hanya dapat membaca profilnya sendiri. Profil/peran dibuat manual oleh admin proyek.
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'ownerUid', 'ticketId', 'reporterName', 'reporterContact', 'category',
          'title', 'description', 'location', 'incidentDate', 'photoPath', 'status',
          'followUpNotes', 'createdAt', 'updatedAt', 'statusHistory'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ticketId', 'reporterName', 'reporterContact', 'category',
          'title', 'description', 'location', 'incidentDate', 'photoPath', 'status',
          'followUpNotes', 'createdAt', 'updatedAt', 'statusHistory'
        ])
        && request.resource.data.ticketId is string
        && request.resource.data.ticketId.size() >= 15
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() > 0
        && request.resource.data.reporterName.size() <= 100
        && request.resource.data.reporterContact is string
        && request.resource.data.reporterContact.size() <= 30
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 2000
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 250
        && request.resource.data.category is string
        && request.resource.data.status == 'Menunggu verifikasi'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Pelapor dapat membaca laporan miliknya pada sesi auth anonim yang sama; admin dapat membaca semua.
      allow get, list: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'statusHistory', 'followUpNotes'
        ])
        && request.resource.data.status in [
          'Menunggu verifikasi', 'Sedang diverifikasi',
          'Diteruskan ke petugas terkait', 'Sedang ditangani', 'Selesai', 'Ditolak'
        ]
        && request.resource.data.updatedAt == request.time
        && request.resource.data.followUpNotes is string
        && request.resource.data.followUpNotes.size() <= 1000;
      allow delete: if false;
    }
  }
}
